# Optional local runtime overrides for repository-root commands.
# Copy to `.env` only when you need to override the checked-in defaults.

# Docker Compose host ports.
AIVIS_BACKEND_HOST_PORT=8080
AIVIS_WORKBENCH_HOST_PORT=3200

# Frontend server-side data source.
# Leave unset for the default local behaviour, or set one explicit value.
# AIVIS_FRONTEND_DATA_SOURCE=mock
# AIVIS_FRONTEND_DATA_SOURCE=backend

# Server-side backend origin for local backend-mode frontend runs.
# Do not expose this through NEXT_PUBLIC_* variables.
# For a local backend process:
# AIVIS_BACKEND_ORIGIN=http://127.0.0.1:8000
# For Docker Compose, the checked-in default is:
# AIVIS_BACKEND_ORIGIN=http://backend:8000
