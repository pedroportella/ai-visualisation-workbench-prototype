# Optional app-local Next.js env file for frontend-only development.
# Copy to `.env.local` in this folder only when you want the app package to
# force bundled fixture mode while running `pnpm --filter @aivis/workbench dev`.

AIVIS_FRONTEND_DATA_SOURCE=mock

# Backend origins stay server-side and are documented in the repository root
# `.env.example`; do not add NEXT_PUBLIC_* backend variables here.
