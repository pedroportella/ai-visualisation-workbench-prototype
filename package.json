{
  "name": "ai-visualisation-workbench-prototype",
  "private": true,
  "version": "0.0.0",
  "description": "Prototype monorepo for the AI Visualisation Workbench.",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "docker:build": "docker compose build",
    "docker:down": "docker compose down",
    "docker:smoke": "backend/.venv/bin/python scripts/local-docker-smoke.py",
    "docker:up": "docker compose up --detach",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "type": "module"
}
