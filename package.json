{
  "name": "ai-visualisation-workbench-prototype",
  "private": true,
  "version": "0.0.0",
  "description": "Prototype monorepo for the AI Visualisation Workbench.",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "docker:build": "docker compose build",
    "docker:config": "docker compose config",
    "docker:down": "docker compose down",
    "docker:smoke": "backend/.venv/bin/python scripts/local-docker-smoke.py",
    "docker:up": "docker compose up --detach",
    "guard": "node scripts/quality-guards.mjs all",
    "guard:app-naming": "node scripts/quality-guards.mjs app-naming",
    "guard:artifacts": "node scripts/quality-guards.mjs artifacts",
    "guard:browser-bundles": "node scripts/quality-guards.mjs browser-bundles",
    "guard:browser-origins": "node scripts/quality-guards.mjs browser-origins",
    "guard:claim-boundaries": "node scripts/quality-guards.mjs claim-boundaries",
    "guard:public-docs": "node scripts/quality-guards.mjs public-docs",
    "guard:secrets": "node scripts/quality-guards.mjs secrets",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm test:e2e:mock",
    "test:e2e:mock": "node scripts/run-playwright.mjs --mode=mock test -c playwright.config.ts tests/e2e/evidence-workbench.mock.spec.ts",
    "test:e2e:mock:headed": "node scripts/run-playwright.mjs --mode=mock test -c playwright.config.ts tests/e2e/evidence-workbench.mock.spec.ts --headed --project=chromium --workers=1",
    "test:e2e:real": "node scripts/run-docker-e2e.mjs",
    "test:e2e:real:headed": "node scripts/run-docker-e2e.mjs --headed",
    "test:e2e:report": "node scripts/run-playwright.mjs show-report",
    "test:backend-release-proof": "node scripts/backend-release-proof.mjs",
    "test:reviewer-evidence": "node scripts/reviewer-evidence-smoke.mjs",
    "test:visual": "node scripts/run-playwright.mjs --mode=mock test -c playwright.config.ts tests/visual/evidence-workbench-layout.spec.ts",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "type": "module"
}
